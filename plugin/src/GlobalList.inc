// generated by tools/make_plugin.py; the order is the FormID order, 000800 upward
X(Enabled)  // 1 when the seasonal temperatures are on
X(Month)  // the game's month, 0 Morning Star .. 11 Evening Star
X(MonthType)  // type of the month: 0 cold, 1 chill, 2 brisk, 3 none, 4 nice, 5 warm, 6 hot
X(MonthTemperature)  // degrees the month's type adds
X(Region)  // Frostfall's region code of the last climate update (-1 unknown)
X(RegionBaseTemperature)  // base temperature of that region this month
X(DayPhase)  // 0 day, 1 dawn or dusk, 2 night
X(DangerousMountain)  // 1 when the dangerous Throat of the World is on
X(ColdCities)  // 1 when Windhelm, Whiterun and Solitude can get cold
X(TEMP_COLD)  // what a cold month adds
X(TEMP_CHILL)  // what a chill month adds
X(TEMP_BRISK)  // what a brisk month adds
X(TEMP_NONE)  // what a none month adds
X(TEMP_NICE)  // what a nice month adds
X(TEMP_WARM)  // what a warm month adds
X(TEMP_HOT)  // what a hot month adds
X(REGION_UNKNOWN_BASE_TEMP)  // unknown / other
X(REGION_PINEFOREST_BASE_TEMP)  // pine forest
X(REGION_VOLCANICTUNDRA_BASE_TEMP)  // volcanic tundra
X(REGION_FALLFOREST_BASE_TEMP)  // fall forest
X(REGION_REACH_BASE_TEMP)  // the Reach and canyons
X(REGION_TUNDRA_BASE_TEMP)  // tundra / steppe
X(REGION_TUNDRAMARSH_BASE_TEMP)  // marsh tundra
X(REGION_COAST_BASE_TEMP)  // north coast
X(REGION_SNOW_BASE_TEMP)  // arctic snow
X(REGION_ASHWASTE_BASE_TEMP)  // ash waste (Solstheim)
X(SunriseStartHour)  // dawn starts
X(SunriseEndHour)  // dawn ends
X(SunsetStartHour)  // dusk starts
X(SunsetEndHour)  // dusk ends
X(TwilightPenalty)  // degrees taken off at dawn and dusk
X(NightPenalty)  // degrees taken off at night
